            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoDenuncia\": \"MALTRATO_PSICOLOGICO\",\n  \"descripcion\": \"Caso de prueba: presunto maltrato psicológico por parte de un docente.\",\n  \"nombreDenunciante\": \"Denunciante de prueba\",\n  \"nombreAfectado\": \"Estudiante de prueba - 3ro de secundaria\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('denuncia_id', j.id);",
                  "pm.test('Protocolo activado', function () { pm.expect(j.protocoloActivado).to.eql(true); pm.expect(j.estado).to.eql('PROTOCOLO_ACTIVADO'); });"
                ]
