# Copia este archivo como .env (NO se sube a GitHub) o define estas variables en Railway.
# Todos los valores son de ejemplo.

# --- Backend (denuncias-api) ---
DB_URL=jdbc:mysql://HOST:3306/BASE?useSSL=true&serverTimezone=America/Lima
DB_USER=usuario_mysql
DB_PASSWORD=cambia-esto
CORS_ALLOWED_ORIGINS=https://tu-frontend.up.railway.app
SPRING_PROFILES_ACTIVE=prod
# Solo para la carga única de datos demo (SPRING_PROFILES_ACTIVE=prod,seed)
SEED_ADMIN_PASSWORD=cambia-esto-min-8
SEED_OPERADOR_PASSWORD=cambia-esto-min-8

# --- Frontend (denuncias-web), se usa al compilar ---
API_URL=https://tu-backend.up.railway.app
